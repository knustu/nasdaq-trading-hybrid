# 기본은 모의투자입니다.
PAPER_INITIAL_BALANCE=10000
PAPER_FEE_RATE=0.0010
PAPER_SLIPPAGE_RATE=0.0005
REQUEST_TIMEOUT_SECONDS=5

# false: 진입 시간 제한 없음(프리마켓/애프터마켓 포함, 신선한 새 봉이 있을 때만 판단)
# true: 미국 정규장에서만 신규 진입
RESTRICT_ENTRY_TO_REGULAR_SESSION=false

# 텔레그램 알림(선택)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# 실거래는 아래 값을 모두 공식 토스증권 개발자 문서에서 확인한 뒤 설정하세요.
# ALLOW_LIVE_TRADING=true로 바꾸기 전 PAPER 모드 검증이 필요합니다.
ALLOW_LIVE_TRADING=false
TOSS_ACCESS_TOKEN=
TOSS_ACCOUNT_SEQ=
TOSS_BASE_URL=https://openapi.tossinvest.com/v1

# 계정에 제공된 최신 공식 문서의 상대 경로를 입력합니다.
# 주문 상태 경로에는 {order_id} 자리표시자가 필요합니다.
TOSS_BALANCE_PATH=
TOSS_ORDER_STATUS_PATH=

# true이면 C++ 엔진이 빌드되지 않았을 때 실행을 차단합니다.
REQUIRE_CPP_ENGINE=true
